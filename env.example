# Токен бота от @BotFather (обязательно)
BOT_TOKEN=1234567890:AAAA-замени-на-свой

# Публичный HTTPS-адрес, где работает этот сервер, без слэша в конце
PUBLIC_URL=https://cat-firefighter.example.com

# Порт (хостинги вроде Render/Railway задают его сами)
PORT=3000

# Кому писать по вопросам оплаты (покажется в /paysupport)
SUPPORT_CONTACT=@your_username

# Твой числовой Telegram id (узнать у @userinfobot). Даёт команды /refund и /payments
ADMIN_IDS=

# Необязательно: секрет для webhook (по умолчанию выводится из токена)
# WEBHOOK_SECRET=
# Папка с базой (по умолчанию ./data)
# DATA_DIR=data
